# Generated by Cargo
# will have compiled files and executables
debug/
target/

*.ply

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
*.blend1

*.hdf5

.vs/
target/
target_check/
# Build artifacts
*.exe

# Python bytecode cache
__pycache__/
*.pyc

# mujoco-rs auto-downloaded native binaries (examples/mujoco_test)
.mujoco_dl/

# Docker Desktop's WSL2 VM disk (images, containers, hf-cache volume incl.
# downloaded model weights) -- relocated here off the C: drive, see
# policy_server/. Entirely disposable/regenerable.
.docker_data/

# Retargeted trajectory clips, regenerated on demand from the source JSON
# (see trajectory::cache)
**/resources/trajectory_cache/

# Robomimic demo datasets. These are converter input only -- see
# tools/robomimic_to_trajectory.py, which documents the source URL + demo id
# for each. lift_ph_low_dim.hdf5 predates this rule and stays tracked.
source_assets/mujoco_trajectories/*.hdf5

# Bulk `--all`-converted trajectory JSON (one subfolder per robomimic task,
# see setup.sh's convert_trajectories) -- deterministically regenerated from
# the gitignored HDF5 above, so there's no reason to carry ~50-60MB of
# regenerable JSON per task in git history. The three hand-picked, already
# playtested single-demo JSON files at the top of trajectories/ (e.g.
# tool_hang_demo_56.json) are a separate, deliberately small, committed
# sample set -- unaffected by this rule.
examples/splat/game_assets/mujoco/trajectories/tool_hang/

node_modules/

openvla_datasets/

# Local docker-compose overrides (machine-specific checkpoint paths) -- see
# policy_server/.env's own header comment.
policy_server/.env

# Teed console output from run_editor.bat (examples/splat) -- see that
# script's own header comment. Local run artifacts, not build output.
examples/splat/logs/

# Per-job durable logs written by launcher/server.py's Job class -- see its
# own comment. Same rationale as examples/splat/logs/ above.
launcher/logs/
